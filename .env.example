# Copy this file to .env for local development.
# Do not commit real secrets.

# Neon Postgres pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT/session signing secret
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: player character master spreadsheet ID.
# Defaults to the built-in ArianRod master sheet if omitted.
# MASTER_SHEET_ID="1fHofIK9o4eeA2HZ_OQP4h4rOt87dzZ7jDCibmrBROug"

# Optional: NPC-only fallback character spreadsheet ID.
# Used only when a character tab is not found in MASTER_SHEET_ID.
# NPC_SHEET_ID="1JmeqtVXbQr3A4z0VwLUDKFU5bjJ8tsQCfhZQ-fn_Dys"

# GM usernames, comma separated. Default in code is ironknight.
GM_USERNAMES="ironknight"

# GM-only world/map spreadsheet ID.
WORLD_SHEET_ID=""

# Optional: world map tab name. Default is the Korean "map" tab used by the app.
# WORLD_TAB_NAME="맵"

# Optional: scheduled world opening time. Defaults to 2026-07-22 00:00 KST.
# WORLD_OPEN_AT="2026-07-22T00:00:00+09:00"
# WORLD_OPEN="1"

# Google Sheets write access.
# Paste the full service account JSON string in Vercel only.
# Also share the master spreadsheet with the JSON's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
