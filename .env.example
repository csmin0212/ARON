# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
# (.env 는 git 에 올라가지 않습니다)

# Neon 등 Postgres 연결 문자열 (대시보드에서 "Pooled connection" 권장)
# 예: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 로그인 세션 서명용 비밀키 (아래 명령으로 새로 생성 가능)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="여기에-긴-랜덤-문자열"

# (선택) 캐릭터 시트 마스터 스프레드시트 ID. 미설정 시 코드 기본값 사용.
# 구글시트 주소 .../spreadsheets/d/<이부분>/edit 의 가운데 값
# MASTER_SHEET_ID="1fHofIK9o4eeA2HZ_OQP4h4rOt87dzZ7jDCibmrBROug"
