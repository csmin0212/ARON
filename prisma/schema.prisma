// 아리안로드 온라인 갤러리 - 데이터베이스 스키마
// 개발: SQLite / 배포: provider 를 "postgresql" 로 바꾸고 DATABASE_URL 만 교체하면 됨

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 회원
model User {
  id           String    @id @default(cuid())
  username     String    @unique // 로그인 아이디
  passwordHash String
  nickname     String // 캐릭터(표시) 닉네임
  avatar       String? // 캐릭터 사진(이미지 URL 또는 프리셋 키)
  profileStatus String? // 프로필 상태 문구 (온라인/오프라인 등 자유 표기)
  profileColor String? // 프로필 꾸미기 강조색 (#rrggbb) — 히어로 배너에 반영
  profileCover String? // 프로필 커버 이미지 URL (또는 /api/image/{id})
  equippedTitle String? // 장착한 대표 칭호 (업적 보상)
  equippedBadge String? // 장착한 대표 배지 (이모지)
  createdAt    DateTime  @default(now())
  posts        Post[]
  comments     Comment[]
  votes        Vote[]
  sheet        CharacterSheet?
  rolls        Roll[]
  worldMsgs    WorldMessage[]
  inventory    InventoryEntry[]
  storageBox   StorageBox?
  achievements UserAchievement[]
  recipes      UserRecipe[]
  tradeOffersSent TradeOffer[] @relation("TradeOfferFrom")
  tradeOffersReceived TradeOffer[] @relation("TradeOfferTo")
  tradeMessages TradeMessage[]
  notifications Notification[]
  mails         Mail[]
  auctionListings AuctionListing[]
  sheetSyncJobs SheetSyncJob[]
  friendshipsFrom  Friendship[]     @relation("FriendshipFrom")
  friendshipsTo    Friendship[]     @relation("FriendshipTo")
  houseInvitesFrom HouseInvite[]    @relation("HouseInviteFrom")
  houseInvitesTo   HouseInvite[]    @relation("HouseInviteTo")
  guestbookOwned   HouseGuestbook[] @relation("GuestbookOwner")
  guestbookWritten HouseGuestbook[] @relation("GuestbookAuthor")
}

// 친구 — userId(요청 보낸 쪽) → friendId(받은 쪽). status: pending | accepted
model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  user   User @relation("FriendshipFrom", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipTo", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId, status])
}

// 집 초대 — 집 주인(fromId)이 친구(toId)를 자택으로 초대. 수락/거절 시 삭제.
model HouseInvite {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  createdAt DateTime @default(now())
  from User @relation("HouseInviteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("HouseInviteTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
}

// 집 방명록 — 방문객(author)이 집 주인(owner)의 방명록대에 남긴 글
model HouseGuestbook {
  id        Int      @id @default(autoincrement())
  ownerId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  owner  User @relation("GuestbookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  author User @relation("GuestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

// 시트 지연 동기화 작업
model SheetSyncJob {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String    @default("gold")
  status      String    @default("pending")
  dueAt       DateTime
  attempts    Int       @default(0)
  lastError   String?
  lockedAt    DateTime?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, kind])
  @@index([status, dueAt])
}

// 업적 정의 (GM 시트 '업적' 탭에서 동기화)
model Achievement {
  id          String   @id // 업적ID
  category    String // 분류
  name        String
  desc        String?
  condType    String // 조건타입 (장소방문/이동횟수/명성 …)
  condValue   String? // 조건값
  rewardTitle String? // 보상칭호
  rewardFame  Int      @default(0) // 보상명성
  badge       String? // 배지 이모지
  secret      Boolean  @default(false) // 공개=HIDDEN 이면 true (달성 전 비공개)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// 유저별 달성 기록
model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achId    String // Achievement.id (FK 아님 — 동기화 교체에 안전)
  earnedAt DateTime @default(now())

  @@unique([userId, achId])
  @@index([userId])
}

// 요리 레시피 정의 (GM 시트 '레시피' 탭에서 동기화)
model CookingRecipe {
  id              String   @id // 레시피ID
  name            String
  category        String
  rank            String
  facility        String
  ingredientsJson String // [{ name, qty }]
  resultName      String
  resultQty       Int      @default(1)
  effect          String?
  duration        String?
  skillExp        Int      @default(0)
  tags            String?
  sellPrice       Int      @default(1)
  weight          Int      @default(1)
  isPublic        Boolean  @default(false)
  order           Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@index([resultName])
}

// 스킬 정의 (GM 시트 '스킬' 탭에서 동기화). 생활 특성, 스킬북, 전투/직업 스킬까지 확장 가능.
model Skill {
  id          String   @id // 스킬ID
  name        String
  category    String // 생활 | 전투 | 직업 | 기타
  kind        String // 낚시 | 채집 | 요리 | 어콜라이트 등
  type        String? // 특성 | 액티브 | 패시브 | 스킬북
  rarity      String? // 일반 | 레어 | 유니크 | 전설 | 신화
  description String?
  effectKey   String?
  effectValue String?
  sourceItem  String?
  isPublic    Boolean  @default(true)
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([category, kind, rarity, enabled])
}

// 전투/직업 스킬 카탈로그 (GM 시트 '전투스킬' 탭에서 동기화)
// 스킬북 아이템 사용 시 sourceItem 으로 연결된 스킬을 캐릭터 시트에 기입한다.
model CombatSkill {
  id          String   @id // 스킬ID
  name        String
  job         String? // 직업 (클래스 전용 제한 — 캐릭터 클래스와 대조)
  category    String? // 분류 (마술/주가 등 — 캐릭터 시트에 기입)
  subCategory String? // 추가분류
  sl          String? // SL
  slMax       String? // SL상한
  timing      String? // 타이밍
  range       String? // 사거리
  check       String? // 판정
  target      String? // 대상
  cost        String? // 코스트
  condition   String? // 사용조건
  effect      String? // 효과
  critical    String? // 크리티컬
  sourceItem  String? // 이 스킬을 가르치는 아이템 ID (Item.id)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([sourceItem])
}

// 유저별 발견한 레시피
model UserRecipe {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId   String // CookingRecipe.id (FK 아님 — 동기화 교체에 안전)
  discoveredAt DateTime @default(now())

  @@unique([userId, recipeId])
  @@index([userId])
}

// 캐릭터 간 직접 거래 제안. 수락 시점에 인벤토리·골드를 다시 검증한 뒤 이동한다.
model TradeOffer {
  id              String   @id @default(cuid())
  fromUserId      String
  fromUser        User     @relation("TradeOfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId        String
  toUser          User     @relation("TradeOfferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  offerItemName   String?
  offerItemEffect String?
  offerItemWeight Int?
  offerItemQty    Int      @default(0)
  offerGold       Int      @default(0)
  requestGold     Int      @default(0)
  message         String?
  fromOfferJson   String? // 거래방 제안 [{ name, effect, weight, qty }]
  toOfferJson     String?
  fromGold        Int      @default(0)
  toGold          Int      @default(0)
  fromConfirmed   Boolean  @default(false)
  toConfirmed     Boolean  @default(false)
  status          String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED
  messages        TradeMessage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fromUserId, status, createdAt])
  @@index([toUserId, status, createdAt])
}

model TradeMessage {
  id        String     @id @default(cuid())
  tradeId   String
  trade     TradeOffer @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  system    Boolean    @default(false)
  content   String
  createdAt DateTime   @default(now())

  @@index([tradeId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    @default("info")
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// 우편함 — GM/시스템이 보내는 우편. 골드·아이템 첨부를 수령(claim)하면 인벤토리/시트에 지급.
model Mail {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  senderName  String    @default("GM") // 표시용 보낸이
  subject     String
  body        String?
  gold        Int       @default(0) // 첨부 골드
  itemName    String? // 첨부 아이템 (Item.id 또는 이름)
  itemQty     Int       @default(0)
  itemMetaJson String? // 첨부 아이템 스냅샷 (효과·중량 — 경매 반송 등 카탈로그에 없는 강화품 보존)
  claimedAt   DateTime? // 첨부 수령 시각 (null = 미수령)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
}

// 경매장(거래 장터) — 즉시구매 전용 MVP.
// 등록 시 아이템을 판매자 인벤(휴대품/생활가방)에서 빼서 itemMeta 스냅샷으로 에스크로한다.
// 구매 시 골드 이동(델타) + 아이템을 구매자 휴대품으로 직접 지급. 취소/만료 시 판매자에게 반송.
model AuctionListing {
  id        String    @id @default(cuid())
  sellerId  String
  seller    User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category  String // 어획물 | 채집품 | 요리 | 재료 | 소비 | 스킬북 | 기타
  itemName  String
  itemMeta  String // JSON 스냅샷 { effect, weight, rank, text, sourceKind }
  quantity  Int       @default(1) // 남은 수량 (부분 구매 시 차감)
  unitPrice Int // 개당 즉시구매가
  floor     Int       @default(0) // 등록 당시 즉시매각 하한(참고/검증)
  status    String    @default("active") // active | sold | cancelled | expired
  feePaid   Int       @default(0) // 등록 수수료(싱크)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  endedAt   DateTime? // 판매/취소/만료 종료 시각

  @@index([status, category, createdAt])
  @@index([sellerId, status])
}

// 캐릭터 시트 (구글 스프레드시트에서 파싱한 핵심 정보 — 향후 맵/판정 기능 밑작업)
model CharacterSheet {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheetTab  String // 마스터 시트의 탭(시트) 이름 = 캐릭터명
  charClass String? // 메인 클래스
  race      String? // 종족
  attribute String? // 속성
  level     Int?
  hp        Int?
  mp        Int?
  fate      Int?
  gold      String? // 시트 원문 골드 (참고용)
  statsJson String? // JSON: [{ key, label, value, mod }]
  // 사이트 라이브 상태 (탐색/게임으로 변동)
  curHp     Int?
  curMp     Int?
  curGold   Int?
  invJson   String? // 인벤토리 JSON [{ name, qty }]
  // 월드(오픈월드) 상태
  locationId     String? // 현재 위치 (Location.id, FK 아님 — 맵 교체에 안전)
  enteredAt      DateTime? // 현재 장소 진입 시각 (이후 채팅만 보임)
  ap             Int? // 행동치 (매일 KST 5시 회복)
  apResetAt      DateTime? // 마지막 행동치 회복 시각
  restedAt       DateTime? // 여관 휴식 마지막 시각 (일일 1회 판정, KST 자정 기준)
  houseTier      String? // small | standard | luxury
  houseRestedAt  DateTime? // 집 휴식 마지막 시각 (여관과 별도, KST 자정 기준)
  housingJson    String? // 하우징 상태 JSON — 가구/효과 확장용
  pendingCatchJson String? // 낚시 미니게임 진행 중 걸린 어종(서버 추첨 결과) — 성공 시 지급
  pendingGatherJson String? // 채집 진행 상태(추첨 결과 + 탐색 완료 시각) — 백그라운드 타이머
  pendingMineJson String? // 채광 진행 상태(추첨 결과 + 탐색 완료 시각) — 백그라운드 타이머
  guildQuestJson String? // 길드 일일 의뢰 상태 JSON { day, offers[], acceptedId, 리롤권, 주간, 파편 } — lib/guildQuests.ts
  dungeonWeek    String? // 던전 주간 키(월요일 05시 KST 기준) — 바뀌면 횟수 리셋
  dungeonRuns    Int       @default(0) // 이번 주 던전 도전 횟수
  discoveredJson String? // 발견한 히든 장소 ID 목록 JSON
  visitedJson    String? // 방문한 모든 장소 ID 목록 JSON (업적 판정용)
  achStatsJson   String? // 업적용 누적 카운터 JSON { 이동횟수, 조사성공횟수 … }
  probeJson      String? // 은밀한 조사 키워드별 마지막 시도 시각 JSON { 정규화키워드: ISO시각 } — 키워드당 쿨다운
  lifeJson       String? // 생활스킬 상태 JSON { fishing/plant: {exp,level}, perks[], pending[] }
  adventurerRank String    @default("D") // 모험가 길드 등급
  fame           Int       @default(0) // 다음 등급까지 누적 명성치
  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 월드 장소 (GM이 구글 시트 "맵" 탭으로 정의 → 동기화)
model Location {
  id        String   @id // 시트의 ID 컬럼
  name      String
  emoji     String?
  desc      String?
  image     String? // 장소 사진 URL (시트 '이미지' 컬럼)
  connJson  String? // 이동 가능한 장소 ID 배열 JSON
  hidden    Boolean  @default(false) // 히든 장소 (발견해야 보임)
  keyword   String? // 히든 발견 키워드 (시트 '키워드')
  cond      String? // 발견 조건: "판정:재주:9" | "아이템:고대의 나침반" (시트 '조건')
  lifeJson  String? // 지역 생활스킬 설정 JSON { gather/fish/combat }
  isStart   Boolean  @default(false) // 입장 지점
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// 던전 — 주간 컨텐츠 (GM 시트 '던전' 탭에서 동기화). 능력치 판정으로 경험점·포션.
model Dungeon {
  id         String @id // 던전ID (시트)
  name       String
  locationId String // 도전하는 장소 (Location.id)
  dc         Int // 달성치
  exp        Int // 경험점 보상 최소 (성공·실패 동일)
  expMax     Int    @default(0) // 경험점 최대 (exp보다 크면 범위 랜덤, 아니면 고정)
  dropsJson  String // 확정 보상 — 성공 시 전부 지급 (DropEntry[] JSON)
  rollDropsJson String? // 확률 보상 — 가중치 분포에서 하나 추첨 (DropEntry[] JSON)
  floor      Int    @default(1)
  order      Int    @default(0)

  @@index([locationId])
}

// 균열 — GM이 특정 장소에 여는 인스턴스 던전 입구. 선착순 정원만큼 진입.
model Rift {
  id         String       @id @default(cuid())
  type       String // 별의 바다 | 망자의 정원 | 핏빛 성채
  originId   String // 균열이 열린 장소 id (Location.id — FK 아님)
  interiorId String // 내부맵 장소 id (Location.id)
  status     String       @default("open") // open | closed
  capacity   Int          @default(4)
  createdAt  DateTime     @default(now())
  members    RiftMember[]

  @@index([originId])
  @@index([status])
}

model RiftMember {
  id       String   @id @default(cuid())
  riftId   String
  rift     Rift     @relation(fields: [riftId], references: [id], onDelete: Cascade)
  userId   String // User.id (FK 아님 — 표시 시 조회)
  joinedAt DateTime @default(now())

  @@unique([riftId, userId])
  @@index([userId])
}

// 생활스킬 채집물/어획물 (GM 시트 '물고기'·'채집' 탭에서 동기화). 낚시/채집 풀의 단일 진실원.
model LifeSkillItem {
  id        String   @id @default(cuid())
  kind      String // 낚시 | 채집 | 채광
  name      String
  rank      Int      @default(0)
  rarity    String? // 별등급 ★ 표기
  weight    Int      @default(1)
  price     Int      @default(0)
  exp       Int      @default(1)
  sizeBase  Int      @default(1)
  sizeVar   Int      @default(1)
  habitat   String? // 강/민물 | 바다 (낚시 전용)
  text      String?
  craftRole   String? // 채광 전용 — 메이저 | 마이너 | 잡석 (무기 제작 분류)
  craftEffect String? // 채광 전용 — 제작효과 "공격력+2, 물방+1, [화염속성]"
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([kind, rank])
}

// 제작 특성([태그]) 사전 — GM 시트 '제작특성' 탭에서 동기화. UI에서 클릭 시 룰 설명 표시.
model CraftTag {
  name      String   @id // 태그명 (대괄호 없이) 예: 화속성
  desc      String // 룰 설명
  slot      String   @default("공용") // 무기 | 방어구 | 공용 — 이 슬롯에 넣어야 태그가 붙음
  stackable Boolean  @default(false) // 같은 태그 중복 허용 여부 (false = 하나만)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// 아이템 도감 (GM 시트 '아이템' 탭에서 동기화)
model Item {
  id        String   @id
  name      String
  category  String? // 재료 | 소모품 | 무기 | 보석 …
  buyPrice  Int? // 상점 구매가 (C2)
  sellPrice Int? // 상점 판매가
  weight    Int? // 휴대품 중량
  desc      String?
  craftEffect String? // 채워지면 장비 제작 마이너 재료로 인정 — "회피+1, [신속]" (에너미 드롭품 등)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// 장소 행동 (GM 시트 '행동' 탭에서 동기화 — 채집/낚시/채굴 등)
model LocationAction {
  id         Int     @id @default(autoincrement())
  locationId String
  kind       String // 채집 | 낚시 | 채굴 … (자유)
  label      String? // 버튼 표기 (없으면 kind)
  apCost     Int     @default(1)
  statLabel  String? // 판정 능력치 (근력/재주/… 한글 라벨)
  dc         Int?
  dropsJson  String // [{ item, qty, gold, weight }] — item:"꽝" 가능
  failText   String?
  order      Int     @default(0)

  @@index([locationId])
}

// 월드 이벤트 — GM 시트 '이벤트' 탭에서 동기화.
// 현재 타입: 최초방문. 보상은 DropEntry[] JSON.
model WorldEvent {
  id            String   @id // 이벤트ID
  locationId    String
  type          String
  name          String
  message       String?
  rewardsJson   String
  publicMessage String?
  active        Boolean  @default(true)
  order         Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([locationId, type, active])
}

// 최초방문 이벤트 지급 기록. eventId unique로 서버 전체에서 1명만 수령.
model WorldEventClaim {
  id         String   @id @default(cuid())
  eventId    String   @unique
  locationId String
  userId     String
  claimedAt  DateTime @default(now())

  @@index([locationId])
  @@index([userId])
}

// 플레이어 인벤토리
model InventoryEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  qty       Int      @default(1)
  meta      String? // 무기 인스턴스(강화/인첸트) 등 — C3
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// 캐릭터별 창고. 기본 중량 30, 추후 골드 확장으로 maxWeight 증가 가능
model StorageBox {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxWeight Int            @default(30)
  entries   StorageEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model StorageEntry {
  id        String     @id @default(cuid())
  boxId     String
  box       StorageBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  sourceKind String?   // null/basic | 낚시 | 채집
  name      String
  effect    String?
  weight    Int?
  rank      Int?
  text      String?
  qty       Int        @default(1)
  updatedAt DateTime   @updatedAt

  @@index([boxId])
}

// 장소 채팅 (같은 장소의 모험가들끼리) — system=true 면 입장/행동 결과 등 시스템 메시지
model WorldMessage {
  id         Int      @id @default(autoincrement())
  locationId String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  system     Boolean  @default(false)
  content    String
  createdAt  DateTime @default(now())

  @@index([locationId, id])
  @@index([locationId, createdAt])
}

// 주사위/판정 로그 (탐색·RP 공용 엔진)
model Roll {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "근력 판정" / "자유 굴림" 등
  dice      String // 굴린 주사위 "[4,3]"
  modifier  Int      @default(0)
  total     Int
  dc        Int? // 목표치
  success   Boolean?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 게시글
model Post {
  id        Int       @id @default(autoincrement())
  category  String // NOTICE | INFO | GENERAL | QUESTION | TRADE
  title     String
  content   String
  views     Int       @default(0)
  createdAt DateTime  @default(now())
  // 거래(TRADE) 전용 필드
  price       Int? // 골드 가격
  tradeType   String? // SELL(팝니다) | BUY(삽니다)
  tradeStatus String? // OPEN(거래중) | CLOSED(거래완료)
  // 회원 작성
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id])
  // 익명 작성
  anonNick  String? // 표시 닉네임 (기본 "ㅇㅇ")
  anonIp    String? // 마스킹된 IP "121.♡.4.12"
  anonPass  String? // 익명 글 수정/삭제용 비밀번호 해시
  comments  Comment[]
  votes     Vote[]
  images    Image[]

  @@index([category, createdAt])
}

// 첨부 이미지 (DB 저장 → /api/image/[id] 로 서빙. 서버리스 배포 호환)
model Image {
  id        Int      @id @default(autoincrement())
  postId    Int?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
  createdAt DateTime @default(now())

  @@index([postId])
}

// 댓글 / 대댓글 (parentId 로 자기참조)
model Comment {
  id           Int       @id @default(autoincrement())
  content      String
  createdAt    DateTime  @default(now())
  isDeleted    Boolean   @default(false)
  postId       Int
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId     Int?
  parent       Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("Replies")
  authorId     String?
  author       User?     @relation(fields: [authorId], references: [id])
  anonNick     String?
  anonIp       String?
  anonPass     String?
  isAuthorPost Boolean   @default(false) // 글 작성자가 단 댓글이면 "작성자" 표시

  @@index([postId])
}

// 추천 / 비추천 (중복 방지)
model Vote {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  voterKey  String // userId 또는 IP — 중복 추천 방지 키
  value     Int      @default(1) // 1 = 추천, -1 = 비추천
  createdAt DateTime @default(now())

  @@unique([postId, voterKey])
}
